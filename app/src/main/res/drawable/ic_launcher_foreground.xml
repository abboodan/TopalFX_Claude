  Every mark sits inside the 66dp safe circle centred on (54,54): the adaptive icon
  mask crops a 108dp canvas down to roughly 72dp, so anything further out gets cut
  on round-mask launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outline -->
    <path
        android:pathData="M54,24 L80,36 L80,56 C80,71 66,82 54,86 C42,82 28,71 28,56 L28,36 Z"
        android:strokeColor="#C9A227"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- T crossbar -->
    <path
        android:fillColor="#C9A227"
        android:pathData="M39,42h30v8.5h-30z" />

    <!-- T stem -->
    <path
        android:fillColor="#C9A227"
        android:pathData="M49.5,50.5h9v24.5h-9z" />
</vector>
